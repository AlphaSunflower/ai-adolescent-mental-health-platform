{
  "name": "ai-adolescent-mental-health-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node -e \"require('node:fs').rmSync('.turbo', { recursive: true, force: true })\"",
    "dev": "turbo run dev --parallel",
    "dev:backend": "pnpm --filter @ai-adolescent-mental-health/backend dev",
    "dev:web-client": "pnpm --filter @ai-adolescent-mental-health/web-client dev",
    "test": "turbo run test",
    "test:backend": "pnpm --filter @ai-adolescent-mental-health/backend test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "1.19.15",
      "body-parser": "2.3.0",
      "brace-expansion@^1.1.0": "1.1.18",
      "brace-expansion@^5.0.0": "5.0.9",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.6",
      "hono": "4.12.34",
      "immutable": "5.1.8",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "nanoid@^3.0.0": "3.3.18",
      "postcss": "8.5.23",
      "postcss-selector-parser@^6": "6.1.3",
      "postcss-selector-parser@^7": "7.1.3",
      "qs": "6.16.0",
      "vite": "8.0.16"
    }
  }
}
