{
  "name": "ai-adolescent-mental-health-platform",
  "private": true,
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node -e \"require('node:fs').rmSync('.turbo', { recursive: true, force: true })\"",
    "dev": "turbo run dev --parallel",
    "dev:backend": "pnpm --filter @ai-adolescent-mental-health/backend dev",
    "dev:web-client": "pnpm --filter @ai-adolescent-mental-health/web-client dev",
    "test": "turbo run test",
    "test:backend": "pnpm --filter @ai-adolescent-mental-health/backend test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  }
}
